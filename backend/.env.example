# Generate a fresh Test Mode key pair after revoking any exposed credentials.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Set this independently in the Razorpay Test Mode webhook configuration.
RAZORPAY_WEBHOOK_SECRET=replace_me_with_a_long_random_secret

# Use a Supabase pooler connection string for hosted PostgreSQL.
# If omitted, local development falls back to backend/data/recoverai.db.
DATABASE_URL=postgresql+psycopg2://user:password@host:6543/postgres?sslmode=require
